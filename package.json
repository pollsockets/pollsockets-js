{
	"name": "pollsockets-js",
	"version": "2.0.0",
	"description": "Client side implementation of pollsockets",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"author": "Vytautas Smilingis",
	"license": "MIT",
	"repository": "https://github.com/pollsockets/pollsockets-js"
}
